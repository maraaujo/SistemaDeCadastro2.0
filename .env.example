# Copie este arquivo para ".env" e preencha com os dados reais.
# O ".env" NAO vai para o Git nem para a imagem Docker.

# Banco MySQL no Aiven (Painel do servico > Connection information).
# Deixe a senha fora daqui: ela vem do DB_PASSWORD abaixo.
ConnectionStrings__DefaultConnection=server=SEU-SERVICO.aivencloud.com;port=25124;database=sistema_cadastro_tcc;user=avnadmin;SslMode=Required;
DB_PASSWORD=troque-pela-senha-do-banco

# Development habilita o Swagger em http://localhost:8080/swagger
# Use Production para rodar como em producao (sem Swagger).
ASPNETCORE_ENVIRONMENT=Development

# Opcional (recomendado em producao): chave JWT propria, com 32+ caracteres.
# Se nao definir, usa a chave padrao do appsettings.json.
# Jwt__Key=troque-por-uma-chave-longa-e-secreta
